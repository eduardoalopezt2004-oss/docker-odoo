<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mantenimiento solo deja ver a un usuario interno los equipos que sigue
         (maintenance.equipment_rule_user). Para prestar hay que poder elegir
         cualquier equipo: esta regla abre solo la lectura. Escribir sigue
         limitado por el acceso estándar (solo lectura para usuarios internos). -->
    <record id="equipment_rule_user_read_all" model="ir.rule">
        <field name="name">Préstamos: usuarios internos leen todos los equipos</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
