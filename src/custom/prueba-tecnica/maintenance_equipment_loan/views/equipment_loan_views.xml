<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_loan_view_list" model="ir.ui.view">
        <field name="name">equipment.loan.list</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('returned', 'cancelled')">
                <field name="equipment_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_delivery"/>
                <field name="date_expected_return"/>
                <field name="date_returned" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'loaned'"
                       decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="equipment_loan_view_form" model="ir.ui.view">
        <field name="name">equipment.loan.form</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_deliver" type="object" string="Entregar"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" type="object" string="Devolver"
                            class="btn-primary" invisible="state != 'loaned'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,loaned,returned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_delivery" readonly="state != 'draft'"/>
                            <field name="date_expected_return" readonly="state != 'draft'"/>
                            <field name="date_returned" invisible="not date_returned"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="equipment_loan_view_search" model="ir.ui.view">
        <field name="name">equipment.loan.search</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="user_id"/>
                <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_loaned" string="Prestados" domain="[('state', '=', 'loaned')]"/>
                <filter name="filter_returned" string="Devueltos" domain="[('state', '=', 'returned')]"/>
            </search>
        </field>
    </record>

    <record id="equipment_loan_action" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">equipment.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra el primer préstamo de un equipo</p>
        </field>
    </record>

    <menuitem id="menu_equipment_loan"
              name="Préstamos"
              parent="maintenance.menu_maintenance_title"
              action="equipment_loan_action"
              groups="base.group_user"
              sequence="3"/>
</odoo>
