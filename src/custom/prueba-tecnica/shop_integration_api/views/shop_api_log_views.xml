<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shop_api_log_view_list" model="ir.ui.view">
        <field name="name">shop.api.log.list</field>
        <field name="model">shop.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="endpoint"/>
                <field name="user_id"/>
                <field name="status_code"/>
                <field name="error_code"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>

    <record id="shop_api_log_view_search" model="ir.ui.view">
        <field name="name">shop.api.log.search</field>
        <field name="model">shop.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="user_id"/>
                <field name="error_code"/>
                <filter string="Con error" name="with_error" domain="[('error_code', '!=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint'}"/>
                    <filter string="Código HTTP" name="group_status" context="{'group_by': 'status_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shop_api_log_action" model="ir.actions.act_window">
        <field name="name">Llamadas a la API de la tienda</field>
        <field name="res_model">shop.api.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="shop_api_log_menu"
              name="Llamadas a la API de la tienda"
              parent="base.menu_custom"
              action="shop_api_log_action"
              groups="base.group_system"
              sequence="50"/>
</odoo>
