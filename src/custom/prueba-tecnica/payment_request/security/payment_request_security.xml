<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_request" model="ir.module.category">
        <field name="name">Solicitudes de pago</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_payment_requester" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="module_category_payment_request"/>
    </record>

    <!-- Aprobador y Tesorería no se incluyen entre sí: quien paga no aprueba.
         Por eso tampoco se asignan al administrador al instalar. -->
    <record id="group_payment_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_requester'))]"/>
    </record>

    <record id="group_payment_treasury" model="res.groups">
        <field name="name">Tesorería</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_requester'))]"/>
    </record>

    <!-- Cualquier empleado puede pedir un pago: todo usuario interno es Solicitante. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_payment_requester'))]"/>
    </record>

    <record id="payment_request_rule_own" model="ir.rule">
        <field name="name">Solicitudes de pago: el solicitante trabaja con las suyas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_requester'))]"/>
    </record>

    <record id="payment_request_rule_read_all" model="ir.rule">
        <field name="name">Solicitudes de pago: Aprobador y Tesorería ven todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_approver')), (4, ref('group_payment_treasury'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Solo para cambiar el estado: los campos de una solicitud enviada los bloquea el modelo. -->
    <record id="payment_request_rule_write_sent" model="ir.rule">
        <field name="name">Solicitudes de pago: Aprobador y Tesorería cambian el estado de las enviadas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('state', '!=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('group_payment_approver')), (4, ref('group_payment_treasury'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
