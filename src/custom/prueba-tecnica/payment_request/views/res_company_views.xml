<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_payment_request" model="ir.ui.view">
        <field name="name">res.company.form.payment_request</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Solicitudes de pago" name="payment_request">
                    <field name="payment_request_code" placeholder="Por ejemplo, DA"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
